// Warp-per-token vectorization adapted from SGLang-for-sail's paged
// dequantize_k_cache v2. Addressing here follows vLLM's request block tables,
// tail gather lengths and output offsets instead of a flat slot list.

#include "torch_utils.h"

#include <hggc_bf16.h>
#include <hggc_runtime.h>
#include <torch/headeronly/core/ScalarType.h>
#include <algorithm>
#include <cmath>
#include <cstdint>

namespace {

union alignas(16) BF16x16 {
  uint4 words[2];
  __ppu_bfloat16 values[16];
};

__device__ __forceinline__ float decode_e4m3(uint8_t value) {
  const int exponent = (value >> 3) & 15;
  const int mantissa = value & 7;
  // Preserve E4M3FN subnormals and signed zero; do not use the SGLang
  // SM80 helper that flushes the whole subnormal FP8 range to zero.
  if ((value & 127) == 127) return __int_as_float(0x7fffffff);
  const float magnitude = exponent == 0
      ? ldexpf(static_cast<float>(mantissa), -9)
      : ldexpf(static_cast<float>(8 + mantissa), exponent - 10);
  return (value & 128) ? -magnitude : magnitude;
}

__global__ void dequant_gather_vector_kernel(
    __ppu_bfloat16* __restrict__ out, const uint8_t* __restrict__ cache,
    const int32_t* __restrict__ seq_lens,
    const int32_t* __restrict__ gather_lens,
    const int32_t* __restrict__ block_table, int64_t out_stride0,
    int64_t out_stride1, int64_t page_stride, int64_t table_stride,
    int64_t page_size, int64_t offset) {
  constexpr int kWarps = 4;
  const int lane = threadIdx.x % 32;
  const int64_t request = blockIdx.y;
  const int64_t gather = gather_lens[request];
  const int64_t start = static_cast<int64_t>(seq_lens[request]) - gather;
  const int element = lane * 16;
  for (int64_t token = static_cast<int64_t>(blockIdx.x) * kWarps + threadIdx.x / 32;
       token < gather; token += static_cast<int64_t>(gridDim.x) * kWarps) {
    const int64_t position = start + token;
    const int64_t physical = block_table[request * table_stride + position / page_size];
    const int64_t within = position % page_size;
    const int64_t base = physical * page_stride + within * 576;
    auto* destination = reinterpret_cast<uint4*>(
        out + request * out_stride0 + (offset + token) * out_stride1 + element);
    if (element >= 448) {
      const auto* source = reinterpret_cast<const uint4*>(cache + base + 448 + (element - 448) * 2);
      destination[0] = source[0];
      destination[1] = source[1];
    } else {
      const uint4 packed = *reinterpret_cast<const uint4*>(cache + base + element);
      const auto* bytes = reinterpret_cast<const uint8_t*>(&packed);
      const uint8_t encoded = cache[physical * page_stride + page_size * 576 + within * 8 + element / 64];
      const float scale = exp2f(static_cast<float>(static_cast<int>(encoded) - 127));
      BF16x16 converted;
#pragma unroll
      for (int i = 0; i < 16; ++i) converted.values[i] = __float2bfloat16(decode_e4m3(bytes[i]) * scale);
      destination[0] = converted.words[0];
      destination[1] = converted.words[1];
    }
  }
}

}  // namespace

void deepseek_dequant_gather_vector(
    torch::stable::Tensor& out, const torch::stable::Tensor& cache,
    const torch::stable::Tensor& seq_lens, const torch::stable::Tensor& gather_lens,
    const torch::stable::Tensor& block_table, int64_t page_size,
    int64_t offset, int64_t max_gather_len) {
  using torch::headeronly::ScalarType;
  STD_TORCH_CHECK(out.dim() == 3 && out.size(2) == 512 && out.scalar_type() == ScalarType::BFloat16,
                  "Expected BF16 output [requests,tokens,512]");
  STD_TORCH_CHECK(cache.dim() == 3 && cache.size(1) == page_size && cache.size(2) == 584 &&
                  cache.scalar_type() == ScalarType::Byte && cache.stride(2) == 1,
                  "Expected legacy packed MLA cache [pages,page_size,584]");
  STD_TORCH_CHECK(seq_lens.dim() == 1 && gather_lens.dim() == 1 &&
                  seq_lens.size(0) == out.size(0) && gather_lens.size(0) == out.size(0) &&
                  seq_lens.stride(0) == 1 && gather_lens.stride(0) == 1 &&
                  seq_lens.scalar_type() == ScalarType::Int && gather_lens.scalar_type() == ScalarType::Int,
                  "Expected contiguous int32 sequence and gather lengths");
  STD_TORCH_CHECK(block_table.dim() == 2 && block_table.size(0) == out.size(0) &&
                  block_table.stride(1) == 1 && block_table.scalar_type() == ScalarType::Int,
                  "Expected int32 request block tables");
  STD_TORCH_CHECK(page_size > 0 && offset >= 0 && offset <= out.size(1) &&
                  max_gather_len >= 0 && max_gather_len <= out.size(1) - offset,
                  "Invalid gather bounds");
  STD_TORCH_CHECK(out.stride(2) == 1 && out.stride(1) >= 512 &&
                  out.stride(0) >= out.size(1) * out.stride(1) &&
                  out.stride(0) % 8 == 0 && out.stride(1) % 8 == 0 &&
                  cache.stride(0) >= page_size * 584 && cache.stride(0) % 16 == 0 &&
                  reinterpret_cast<uintptr_t>(out.const_data_ptr()) % 16 == 0 &&
                  reinterpret_cast<uintptr_t>(cache.const_data_ptr()) % 16 == 0,
                  "Vector gather requires aligned, non-overlapping rows and 16-byte aligned pages");
  const auto device = out.get_device_index();
  STD_TORCH_CHECK(device >= 0 && cache.get_device_index() == device &&
                  seq_lens.get_device_index() == device && gather_lens.get_device_index() == device &&
                  block_table.get_device_index() == device, "All gather tensors must be on the same PPU");
  if (out.size(0) == 0 || max_gather_len == 0) return;
  STD_TORCH_CHECK(out.size(0) <= 65535, "Too many requests for vector gather grid");
  torch::stable::accelerator::DeviceGuard guard(device);
  const int64_t blocks = std::min<int64_t>((max_gather_len + 3) / 4, get_device_prop()->multiProcessorCount * 4);
  const dim3 grid(static_cast<unsigned>(blocks), static_cast<unsigned>(out.size(0)));
  dequant_gather_vector_kernel<<<grid, 128, 0, get_current_cuda_stream(device)>>>(
      reinterpret_cast<__ppu_bfloat16*>(out.mutable_data_ptr()),
      cache.const_data_ptr<uint8_t>(), seq_lens.const_data_ptr<int32_t>(),
      gather_lens.const_data_ptr<int32_t>(), block_table.const_data_ptr<int32_t>(),
      out.stride(0), out.stride(1), cache.stride(0), block_table.stride(0), page_size, offset);
  STD_CUDA_KERNEL_LAUNCH_CHECK();
}
